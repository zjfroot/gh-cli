    srcs = ["status_test.go"],
    embed = [":status"],
    deps = [
        "//internal/config",
        "//internal/gh",
        "//pkg/cmdutil",
        "//pkg/httpmock",
        "//pkg/iostreams",
        "@com_github_google_shlex//:shlex",
        "@com_github_makenowjust_heredoc//:heredoc",
        "@com_github_stretchr_testify//assert",
