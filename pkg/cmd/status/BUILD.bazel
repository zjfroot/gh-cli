load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "status",
    srcs = ["status.go"],
    importpath = "github.com/cli/cli/v2/pkg/cmd/status",
    visibility = ["//visibility:public"],
    deps = [
        "//api",
        "//internal/tableprinter",
        "//pkg/cmd/factory",
        "//pkg/cmdutil",
        "//pkg/iostreams",
        "//pkg/set",
        "@com_github_charmbracelet_lipgloss//:lipgloss",
