load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "gen-docs_lib",
    srcs = ["main.go"],
    importpath = "github.com/cli/cli/v2/cmd/gen-docs",
    visibility = ["//visibility:private"],
    deps = [
        "//internal/config",
        "//internal/docs",
        "//internal/gh",
        "//internal/ghrepo",
        "//pkg/cmd/root",
        "//pkg/cmdutil",
        "//pkg/extensions",
        "//pkg/iostreams",
        "@com_github_spf13_pflag//:pflag",
    ],
)

go_binary(
    name = "gen-docs",
    embed = [":gen-docs_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "gen-docs_test",
    srcs = ["main_test.go"],
    embed = [":gen-docs_lib"],
)
